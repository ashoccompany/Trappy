trst
    txt "Hello World" tit greeting
    gan greeting

    ftxt shout word
        answ word + "!!!"
    tren

    txt shout greeting tit loud_greeting
    gan loud_greeting

    mh 25 eq score
    ifr score 10 grt
        gan "Big number!"
    then
        gan "Small number!"
    tren

    rep 3
        gan "Trappy loop running!"
    tren

    lst 100 | 200 | 300 | 400 eq highscores
    gan highscores

    fdel wipe_cache target
    tren

    trg wipe_cache greeting
tren
