# =====================================================================
# TRAPPY 3D WIREFRAME ENGINE DEMO (.trappy)
# Demonstrating:
# 1. Real 3D Perspective Projection (cube3d & line3d)
# 2. Real-time 3D rotation with W, A, S, D
# 3. 3D Depth Pacing with Calm FPS
# =====================================================================
trst
    cwin "Trappy 3D Engine" 600:450 main
    sbgwin "Trappy 3D Engine" black
    fps calm

    # 3D Cube Center Coordinates and Angles
    mh 300 eq cube_x
    mh 225 eq cube_y
    mh 0 eq cube_z
    mh 140 eq cube_size

    # Rotation Angles (Pitch & Yaw)
    mh 20 eq rot_x
    mh 30 eq rot_y

    gloop
        # 3D HUD
        label "TRAPPY 3D WIREFRAME ENGINE" 300:25 cyan
        label "ROTATE CUBE: [W / S] Pitch  |  [A / D] Yaw" 300:420 yellow

        # Continuous gentle auto-spin
        mh rot_y + 1 eq rot_y

        # Draw 3D Cube with perspective projection
        cube3d cube_x:cube_y:cube_z cube_size rot_x:rot_y cyan

        # Keyboard 3D Controls
        ifr key "W" trg then mh rot_x - 3 eq rot_x
        ifr key "S" trg then mh rot_x + 3 eq rot_x
        ifr key "A" trg then mh rot_y - 3 eq rot_y
        ifr key "D" trg then mh rot_y + 3 eq rot_y
    tren
tren
