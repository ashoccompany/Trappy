# =====================================================================
# TRAPPY 2D COIN COLLECTOR & HAZARD JUMPER (.trappy)
# Features:
# 1. 5 Collectible Coins that disappear when touched
# 2. Pseudo-3D Jump (Cyan grows BIG in the air, falls back to normal)
# 3. Red Hazard Box: Damaging on ground, but completely bypassed in AIR!
# 4. Built-in Beep Audio Sound Effects & Score Counter!
# =====================================================================
trst
    cwin "Trappy: Coin Collector & Hazard Jumper" 600:400 main
    sbgwin "Trappy: Coin Collector & Hazard Jumper" black
    fps calm

    # Player position, radius, and jump state
    mh 80 eq player_x
    mh 200 eq player_y
    mh 16 eq player_r
    mh 0 eq jump_t
    mh 0 eq in_air
    mh 0 eq score

    # 5 Coins (X, Y, Active: 1=active, 0=collected)
    mh 120 eq c1_x
    mh 90 eq c1_y
    mh 1 eq c1_act

    mh 480 eq c2_x
    mh 100 eq c2_y
    mh 1 eq c2_act

    mh 400 eq c3_x
    mh 320 eq c3_y
    mh 1 eq c3_act

    mh 130 eq c4_x
    mh 310 eq c4_y
    mh 1 eq c4_act

    mh 510 eq c5_x
    mh 220 eq c5_y
    mh 1 eq c5_act

    # Red Hazard obstacle
    mh 260 eq haz_x
    mh 160 eq haz_y
    mh 70 eq haz_w
    mh 70 eq haz_h

    gloop
        # 1. Draw HUD: Title & Score
        label "TRAPPY ADVENTURE" 120:25 cyan
        label "SCORE:" 480:25 white
        label score 550:25 yellow

        # 2. Draw Red Hazard
        regle haz_x:haz_y haz_w:haz_h red
        label "DANGER" 295:195 white

        # 3. Draw Active Coins (Yellow Circles)
        ifr c1_act sm 1
            circ c1_x:c1_y 9 yellow
        tren

        ifr c2_act sm 1
            circ c2_x:c2_y 9 yellow
        tren

        ifr c3_act sm 1
            circ c3_x:c3_y 9 yellow
        tren

        ifr c4_act sm 1
            circ c4_x:c4_y 9 yellow
        tren

        ifr c5_act sm 1
            circ c5_x:c5_y 9 yellow
        tren

        # 4. Player Movement (W, A, S, D)
        ifr key "W" trg then mh player_y - 4 eq player_y
        ifr key "S" trg then mh player_y + 4 eq player_y
        ifr key "A" trg then mh player_x - 4 eq player_x
        ifr key "D" trg then mh player_x + 4 eq player_x

        # 5. Jump / Gravity Mechanics (Spacebar)
        ifr flkey "SPACE" trged
            ifr jump_t sm 0
                mh 18 eq jump_t
                mh 1 eq in_air
                beep 600:40
            tren
        tren

        # Air physics countdown
        ifr jump_t grt 0
            mh jump_t - 1 eq jump_t
            mh 26 eq player_r
            label "AIRBORNE! (IMMUNE TO HAZARDS)" 300:375 lightblue
        then
            mh 0 eq in_air
            mh 16 eq player_r
            label "ON GROUND (VULNERABLE)" 300:375 gray
        tren

        # Draw Player
        circ player_x:player_y player_r cyan

        # 6. Hazard Collision Check (Safe if in_air sm 1)
        ifr player_x grt 240
            ifr player_x lss 350
                ifr player_y grt 140
                    ifr player_y lss 250
                        ifr in_air sm 1
                            label "BYPASSED HAZARD SAFELY IN AIR!" 300:55 lightgreen
                        then
                            label "OUCH! TOUCHED RED HAZARD!" 300:55 red
                            beep 180:30
                        tren
                    tren
                tren
            tren
        tren

        # 7. Coin 1 Collection
        ifr c1_act sm 1
            ifr player_x grt 100
                ifr player_x lss 140
                    ifr player_y grt 70
                        ifr player_y lss 110
                            mh 0 eq c1_act
                            mh score + 1 eq score
                            beep 1100:60
                        tren
                    tren
                tren
            tren
        tren

        # Coin 2 Collection
        ifr c2_act sm 1
            ifr player_x grt 460
                ifr player_x lss 500
                    ifr player_y grt 80
                        ifr player_y lss 120
                            mh 0 eq c2_act
                            mh score + 1 eq score
                            beep 1100:60
                        tren
                    tren
                tren
            tren
        tren

        # Coin 3 Collection
        ifr c3_act sm 1
            ifr player_x grt 380
                ifr player_x lss 420
                    ifr player_y grt 300
                        ifr player_y lss 340
                            mh 0 eq c3_act
                            mh score + 1 eq score
                            beep 1100:60
                        tren
                    tren
                tren
            tren
        tren

        # Coin 4 Collection
        ifr c4_act sm 1
            ifr player_x grt 110
                ifr player_x lss 150
                    ifr player_y grt 290
                        ifr player_y lss 330
                            mh 0 eq c4_act
                            mh score + 1 eq score
                            beep 1100:60
                        tren
                    tren
                tren
            tren
        tren

        # Coin 5 Collection
        ifr c5_act sm 1
            ifr player_x grt 490
                ifr player_x lss 530
                    ifr player_y grt 200
                        ifr player_y lss 240
                            mh 0 eq c5_act
                            mh score + 1 eq score
                            beep 1100:60
                        tren
                    tren
                tren
            tren
        tren
    tren
tren
