trst
    gan "=== TRAPPY FILE SYSTEM & OFFLINE STORAGE ==="

    dict tit player_profile
    dset player_profile:"name":"TrappyKnight"
    dset player_profile:"level":12
    dset player_profile:"gold":750
    dset player_profile:"equipped_weapon":"Crystal Blade"

    json_dump player_profile tit save_content

    txt "player_save.dat" tit save_filename
    file_write save_filename:save_content
    gan "Saved profile data to local file: player_save.dat"

    file_exists save_filename tit exists_flag
    ifr exists_flag sm 1
        gan "File verified on local storage! Reading data back..."
        file_read save_filename tit loaded_raw
        json_parse loaded_raw tit loaded_profile

        dget loaded_profile:"name" tit hero_name
        dget loaded_profile:"gold" tit hero_gold
        dget loaded_profile:"equipped_weapon" tit hero_sword

        gan "Restored Hero Profile:"
        gan hero_name
        gan "Gold Coins:"
        gan hero_gold
        gan "Equipped Weapon:"
        gan hero_sword
    then
        gan "Error: Save file was not found!"
    tren

    file_delete save_filename
    gan "Save file cleaned up. System ready."
    gan "=== DEMO COMPLETE ==="
tren
