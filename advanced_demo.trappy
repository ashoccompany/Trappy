trst
    add_var "battle_round"
    add_obj "hero"
        name: "TrappyKnight"
        hp: 100
        attack: 35
        defense: 12
    tren

    add_obj "boss"
        name: "Dragon"
        hp: 200
        attack: 28
    tren

    add_func "compute_strike"

    fmh compute_strike atk:def
        answ atk - def
    tren

    mh compute_strike hero.attack:10 eq hero_dmg
    mh boss.hp - hero_dmg eq boss.hp

    gan "Hero attacked Boss! Remaining Boss HP:"
    gan boss.hp

    lst "Health Potion" | "Magic Ring" | "Golden Key" eq backpack
    gan "Inventory contents:"
    each item in backpack
        gan ">>> " + item
    tren
tren
