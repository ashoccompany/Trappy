# =====================================================================
# TRAPPY DESKTOP APPLICATION DEMO (.trappy)
# Demonstrating: Windows, Buttons, Inputs, Labels & UI Functions!
# =====================================================================
trst
    # 1. Create App Window
    cwin "Trappy Desktop App" 450:350 main
    sbgwin "Trappy Desktop App" dark

    # 2. UI Click Handler Function
    fui on_click
        gan "Hello from Trappy Button!"
    tren

    # 3. Add UI Elements
    label "Welcome to Trappy Desktop UI" 225:40 white
    btn "Click Me!" 180:100 trg on_click
    inp "Type your name..." 160:160 tit user_name
tren
